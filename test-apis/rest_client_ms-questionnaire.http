@MS-QUESTIONNAIRE_URL=http://127.0.0.1:3002


@QUESTIONNAIRE_ENDPOINT=questionnaire
@ANSWER_ENDPOINT=answer
@ID_QUESTIONNAIRE=

### CREATE A NEW QUESTIONNAIRE
POST {{MS-QUESTIONNAIRE_URL}}/{{QUESTIONNAIRE_ENDPOINT}}
Content-Type: application/json
Authorization:

{
  "title": "Sample Questionnaire 2",
  "sections": [
    {
      "title": "Section 1",
      "questions": [
        {
          "content": "Explain your answer?",
          "observation": "Provide a short explanation",
          "answers": [
            { "content": "SI" },
            { "content": "NO" }
          ]
        }
      ]
    }
  ]
}

### GET QUESTIONNAIRES
GET {{MS-QUESTIONNAIRE_URL}}/{{QUESTIONNAIRE_ENDPOINT}}

### GET QUESTIONNAIRE BY ID
GET {{MS-QUESTIONNAIRE_URL}}/{{QUESTIONNAIRE_ENDPOINT}}/{{ID_QUESTIONNAIRE}}

### DELETE QUESTIONNAIRE BY ID
DELETE {{MS-QUESTIONNAIRE_URL}}/{{QUESTIONNAIRE_ENDPOINT}}/{{ID_QUESTIONNAIRE}}